@model EmployeeVM
@{
    ViewData["Title"] = "Edit";
}
<div asp-validation-summary="All"></div> 
<h1>Edit @Model.Name Employee</h1>
<div asp-validation-summary="All"></div>

<form class="mt-2" asp-action="Edit" method="post" enctype="multipart/form-data">

    <partial name="PartialViews/CreateEditPartialView" />

    <input type="submit" value="Save" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-light">Back To List</a>
</form>
@section ValidationScriptSection {
    <partial name="_ValidationScriptsPartial" />
}