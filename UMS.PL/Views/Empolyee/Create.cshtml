@model EmployeeVM
@inject IDepartmentRepository departmentRepository

@{
    ViewData["Title"] = "CreateEmpolyee";
    var departments = new SelectList(await departmentRepository.GetAllAsync(), "Id", "Name");

}
<div asp-validation-summary="All"></div>

<h1>Create New Employee</h1>
<form class="mt-2" asp-action="Create" enctype="multipart/form-data">

    <partial name="PartialViews/CreateEditPartialView" />

    <input type="submit" value="Submit" class="btn btn-primary" />

    <a asp-action="Index" class="btn btn-light">Back To List</a>

</form>
@section ValidationScriptSection {
    <partial name="_ValidationScriptsPartial" />
}