@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "AuthLayout";
}

<header class="auth-head">
    <h1>Welcome back</h1>
    <p>Sign in to pick up where you left off.</p>
</header>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="All" class="auth-alert"></div>

    <div class="field">
        <input asp-for="Email" placeholder=" " autocomplete="email" />
        <label asp-for="Email"></label>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="field has-toggle">
        <input asp-for="Password" placeholder=" " autocomplete="current-password" />
        <label asp-for="Password"></label>
        <button type="button" class="reveal-btn" data-toggle-password aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="row">
        <label class="check"><input asp-for="RememberMe" /> Keep me signed in</label>
        <a href="#">Forgot password?</a>
    </div>

    <button type="submit" class="btn-auth">Sign in</button>
</form>

<p class="auth-switch">New here? <a asp-action="Register">Create an account</a></p>

@section ValidationScriptSection {
    <partial name="_ValidationScriptsPartial" />
}
