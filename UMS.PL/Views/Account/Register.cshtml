@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    ViewData["StageLine1"] = "Set up in a minute.";
    ViewData["StageLine2"] = "Nothing to install.";
    Layout = "AuthLayout";
}

<header class="auth-head">
    <h1>Create your account</h1>
    <p>It takes less than a minute.</p>
</header>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

    <div class="field">
        <input asp-for="FullName" placeholder=" " autocomplete="name" />
        <label asp-for="FullName"></label>
        <span asp-validation-for="FullName"></span>
    </div>

    <div class="field">
        <input asp-for="Email" placeholder=" " autocomplete="email" />
        <label asp-for="Email"></label>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="field has-toggle">
        <input asp-for="Password" placeholder=" " autocomplete="new-password" data-strength-input />
        <label asp-for="Password"></label>
        <button type="button" class="reveal-btn" data-toggle-password aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="strength" data-strength data-level="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="field">
        <input asp-for="ConfirmPassword" placeholder=" " autocomplete="new-password" />
        <label asp-for="ConfirmPassword"></label>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn-auth">Create account</button>
</form>

<p class="auth-switch">Already have an account? <a asp-action="Login">Sign in</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
