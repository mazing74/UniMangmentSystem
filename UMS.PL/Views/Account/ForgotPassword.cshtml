@model ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "AuthLayout";
}
<form asp-action="SendEmail" method="post" novalidate>
    <div asp-validation-summary="All" class="auth-alert"></div>

    <div class="field">
        <input asp-for="Email" placeholder=" " autocomplete="email" />
        <label asp-for="Email"></label>
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="btn-auth">Reset Password</button>
</form>