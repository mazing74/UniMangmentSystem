@* : لما اخلي الفيو يبقا فيه موديل كدا بيبقا 
-strongly typed view *@
@model Department
@{
    ViewData["Title"] = "Edit Page";
}
<div asp-validation-summary="All"></div>

<h1>Edit @Model.Name Department</h1>

<form class="mt-2" asp-action="Edit" method="post">
    <div class="form-group">
        <label class="col-form-label" asp-for="Code"></label>
        <input class="form-control" asp-for="Code" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="col-form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="col-form-label" asp-for="DateOfCreation"></label>
        <input class="form-control" asp-for="DateOfCreation" />
        <span asp-validation-for="DateOfCreation" class="text-danger"></span>
    </div>
    <br />
    <input type="submit" value="Save Changes" class="btn btn-primary" />
    <a asp-action="Index" class="btn btn-light">Back To List</a>
</form>
@section  Scripts{
    <partial name="_ValidationScriptsPartial" />

}