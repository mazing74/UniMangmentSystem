@model DepartmentVM
@{
    ViewData["Title"] = "Delete Page";
}
<div asp-validation-summary="All"></div>

<h1>Are You Sure You Want Delete @Model.Name Department?</h1>

<form class="mt-2" asp-action="Delete" method="post">
    <partial name="PartialViews/DeleteDetailsPartialView" />

    <br />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>
